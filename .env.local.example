# ==========================================
# Kimoxa - Variables d'environnement (TEMPLATE VIDE)
# Copier vers .env.local et remplir les valeurs
# Ne jamais commiter .env.local sur GitHub
# ==========================================

# ------------------------------------------
# URL publique du site — IMPORTANT
# ------------------------------------------
# Ces TROIS variables doivent TOUJOURS être réglées sur la MÊME valeur.
# Le code les utilise à des endroits différents (métadonnées SEO, liens
# dans les e-mails, redirection OAuth, appels internes serveur) sans
# qu'il y ait de variable unique consolidée — en régler une seule ne
# suffit pas si tu changes de domaine (prod, preview, nouvel environnement).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# ------------------------------------------
# Base de données (Neon)
# ------------------------------------------
DATABASE_URL=

# ------------------------------------------
# Authentification
# ------------------------------------------
JWT_SECRET=
# Secret partagé entre le middleware et /api/internal/session-status
INTERNAL_STATUS_SECRET=

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------
# Tâches planifiées (Vercel Cron)
# ------------------------------------------
# Secret vérifié (timing-safe) sur toutes les routes /api/cron/*
CRON_SECRET=

# ------------------------------------------
# Paiement — fournisseur actif
# ------------------------------------------
# Valeurs possibles : sandbox | ligdicash | cinetpay
PAYMENT_PROVIDER=sandbox

# --- Sandbox (tests uniquement, jamais en production) ---
# Secret HMAC signant les capabilities temporaires (jamais exposé au navigateur)
PAYMENT_SANDBOX_SECRET=
# Doit valoir "1" pour activer /api/sandbox/simulate (en plus de NODE_ENV != production)
ALLOW_SANDBOX_SIMULATION=
# Ne JAMAIS mettre à "1" en production réelle, sauf test exceptionnel encadré
ALLOW_SANDBOX_IN_PROD=

# --- Ligdicash ---
LIGDICASH_API_KEY=
LIGDICASH_API_USER=
# Valeurs possibles : test | live
LIGDICASH_MODE=test
LIGDICASH_WEBHOOK_SECRET=

# --- CinetPay ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_WEBHOOK_SECRET=
CINETPAY_PAYOUT_URL=
CINETPAY_PAYOUT_STATUS_URL=

# ------------------------------------------
# Reversements vendeurs
# ------------------------------------------
# Valeurs possibles : manual | auto — laisser "manual" tant que le
# virement automatique n'a pas été validé en conditions réelles.
PAYOUT_MODE=manual

# ------------------------------------------
# Commission Kimoxa
# ------------------------------------------
COMMISSION_RATE_PERCENT=8

# ------------------------------------------
# Email (Resend)
# ------------------------------------------
RESEND_API_KEY=
# Le nom de variable est bien EMAIL_FROM (pas FROM_EMAIL)
EMAIL_FROM=Kimoxa <no-reply@kimoxa.com>
# Optionnel : force TOUS les e-mails de test vers une seule adresse
# (utile en environnement de test pour ne jamais spammer un vrai client)
EMAIL_TEST_OVERRIDE=false
EMAIL_TEST_RECIPIENT=

# ------------------------------------------
# Stockage fichiers (Vercel Blob)
# ------------------------------------------
BLOB_READ_WRITE_TOKEN=
FASOIMG_READ_WRITE_TOKEN=

# ------------------------------------------
# Rate limiting distribué (Upstash Redis via Vercel KV)
# ------------------------------------------
# Optionnel : sans ces deux valeurs, le rate-limit bascule automatiquement
# sur un stockage en mémoire (suffisant en local, pas en production multi-instance)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ------------------------------------------
# Analytics (Plausible)
# ------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ------------------------------------------
# Test helpers — JAMAIS "1"/"true" en production
# ------------------------------------------
ALLOW_TEST_HELPERS=false
