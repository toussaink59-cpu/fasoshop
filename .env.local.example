# ==========================================
# Kimoxa - Variables d'environnement (TEMPLATE VIDE)
# Copier vers .env.local et remplir les valeurs
# ==========================================

# Base de données (Neon)
DATABASE_URL=

# JWT
JWT_SECRET=

# Session
INTERNAL_STATUS_SECRET=

# Paiement Ligdicash
LIGDICASH_API_URL=https://api.ligdicash.com/v1
LIGDICASH_API_KEY=
LIGDICASH_WEBHOOK_SECRET=
PAYMENT_PROVIDER=ligdicash

# Commission Kimoxa
COMMISSION_RATE_PERCENT=8

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=noreply@kimoxa.com

# URL publique
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Test helpers
ALLOW_TEST_HELPERS=false

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
