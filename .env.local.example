# Copie ce fichier en .env.local et remplis les valeurs
# Ne jamais commiter .env.local sur GitHub

# URL de connexion Neon (Postgres) — trouvable dans ton dashboard Neon
DATABASE_URL=postgres://user:password@ep-xxxxx.neon.tech/fasoshop?sslmode=require

# Secret utilisé pour signer les tokens JWT — génère une longue chaîne aléatoire
JWT_SECRET=remplace-moi-par-une-longue-chaine-secrete-aleatoire
