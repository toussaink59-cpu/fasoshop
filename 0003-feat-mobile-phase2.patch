+/* ============================================
+   PHASE 2 — Hero compact, cartes de confiance, sections homepage
+   ============================================ */
+
+/* ---- Cartes de confiance (remplace l'ancienne bande texte simple) ---- */
+.trust-strip {
+  display: flex;
+  gap: 12px;
+  overflow-x: auto;
+  scrollbar-width: none;
+  padding: 16px;
+}
+
+.trust-strip::-webkit-scrollbar {
+  display: none;
+}
+
+.trust-card {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  flex: 0 0 auto;
+  min-width: 210px;
+  background: #fff;
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  padding: 12px 16px;
+  scroll-snap-align: start;
+}
+
+.trust-card .trust-icon {
+  font-size: 1.4rem;
+  flex-shrink: 0;
+}
+
+.trust-card-title {
+  margin: 0;
+  font-size: 0.85rem;
+  font-weight: 600;
+  color: var(--ink-900);
+}
+
+.trust-card-desc {
+  margin: 2px 0 0;
+  font-size: 0.72rem;
+  color: var(--ink-400);
+}
+
+@media (min-width: 768px) {
+  .trust-strip {
+    justify-content: center;
+    flex-wrap: wrap;
+    overflow: visible;
+  }
+}
+
+/* ---- Lien "Voir tout" des sections homepage ---- */
+.section-see-all {
+  color: var(--millet-600);
+  font-weight: 600;
+  font-size: 0.85rem;
+  text-decoration: none;
+  white-space: nowrap;
+}
+
+.section-see-all:hover {
+  text-decoration: underline;
+}
+
+.flash-see-all {
+  color: #fff;
+  font-size: 0.8rem;
+}
+
+/* ---- Sections produits en défilement horizontal (Nouveautés, etc.) ---- */
+.home-hscroll-track {
+  display: flex;
+  gap: 12px;
+  overflow-x: auto;
+  scroll-snap-type: x proximity;
+  scrollbar-width: none;
+  padding-bottom: 4px;
+}
+
+.home-hscroll-track::-webkit-scrollbar {
+  display: none;
+}
+
+.home-hscroll-item {
+  flex: 0 0 160px;
+  scroll-snap-align: start;
+}
+
+@media (min-width: 768px) {
+  .home-hscroll-item {
+    flex-basis: 200px;
+  }
+}
+
+/* ---- Badge "Boutique vérifiée" sur les cartes produit ---- */
+.shop-card-shop-row {
+  display: flex;
+  align-items: center;
+  gap: 5px;
+  padding: 0 14px;
+}
+
+.shop-card-shop-row .shop {
+  padding: 0;
+}
+
+.shop-card-verified {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 14px;
+  height: 14px;
+  border-radius: 50%;
+  background: var(--millet-600);
+  color: #fff;
+  font-size: 0.55rem;
+  font-weight: 700;
+  flex-shrink: 0;
+}
+
+.shop-card-compact .shop-card-name {
+  font-size: 0.85rem;
+}
